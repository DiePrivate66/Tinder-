generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/auth"
}

datasource db {
  provider = "postgresql"
}

model AuthDevice {
  id                Int           @id @default(autoincrement())
  userId            Int
  deviceFingerprint String
  platform          String?
  appVersion        String?
  lastLoginAt       DateTime?
  sessions          UserSession[]
  createdAt         DateTime      @default(now())

  @@unique([userId, deviceFingerprint])
  @@index([userId])
}

model UserSession {
  id               Int         @id @default(autoincrement())
  userId           Int
  authDeviceId     Int?
  refreshTokenHash String      @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  authDevice       AuthDevice? @relation(fields: [authDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([authDeviceId])
}
